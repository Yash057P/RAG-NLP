# ---------------------------------------------------------------------------
# RAG-NLP Assistant - example configuration
# Copy to `.env` in the repository root and adjust as needed.
# Every value below is optional; the defaults shown are what the app uses.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="RAG-NLP Assistant"
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | production | test
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Storage ---------------------------------------------------------------
# Paths are relative to the repository root.
# DATA_DIR=.
# UPLOAD_DIR=./uploads
# VECTOR_STORE_DIR=./vector_store
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# --- Chunking (pipeline step 3) -------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Embeddings (pipeline step 5) ------------------------------------------
# auto       -> sentence-transformers, falls back to a hashed embedder
# huggingface -> force all-MiniLM-L6-v2 (fails loudly if unavailable)
# hashing    -> force the dependency-free offline embedder
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# --- Vector store (pipeline step 6) ---------------------------------------
# auto  -> langchain-chroma, then chromadb, then the built-in NumPy index
# chroma -> require ChromaDB
# numpy  -> always use the built-in flat cosine index
VECTOR_STORE_BACKEND=auto
CHROMA_COLLECTION=rag_documents
# CHROMA_PERSIST_DIRECTORY=./vector_store/chroma

# --- Retrieval (pipeline step 7) ------------------------------------------
TOP_K=5
MIN_SIMILARITY=0.05
# Minimum fraction of the question's terms that must appear in the retrieved
# context before the LLM is allowed to answer instead of abstaining.
GROUNDING_THRESHOLD=0.18

# --- Answer generation (pipeline step 8) ----------------------------------
# auto -> first available of openai, ollama, mistral
# extractive -> deterministic offline baseline (no API key needed)
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=120

# OpenAI (or any OpenAI-compatible gateway, e.g. a local vLLM server)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama - run `ollama serve` and `ollama pull llama3.1`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
